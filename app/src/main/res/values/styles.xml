<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#806333</item>
        <item name="android:colorBackground">#F8F6F1</item>
        <item name="android:textColorPrimary">#252924</item>
        <item name="android:textColorSecondary">#626458</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F8F6F1</item>
        <item name="android:navigationBarColor">#F8F6F1</item>
        <item name="android:windowBackground">#F8F6F1</item>
        <item name="android:alertDialogTheme">@style/SpencerianDialog</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="SpencerianDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#806333</item>
        <item name="android:colorBackground">#FFFDFA</item>
        <item name="android:textColorPrimary">#252924</item>
        <item name="android:textColorSecondary">#626458</item>
    </style>
</resources>
